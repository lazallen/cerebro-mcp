{
  "version": "1.0",
  "_comment": "Smart Meeting Scheduler config. History tracks last 3+ occurrences for scheduling weight.",
  "settings": {
    "lookAheadDays": 21,
    "minNoticePeriodHours": 48,
    "timezone": "Europe/London",
    "historyRetentionCount": 5,
    "rebalanceCadence": "weekly",
    "_rebalanceCadenceNote": "Rebalance pass cadence: 'weekly' (Monday morning) or 'daily'. Controls conflict/imbalance scan over the 21-day window.",
    "timePortfolio": {
      "workingHoursStart": "09:00",
      "workingHoursEnd": "17:00",
      "workingDays": ["MON", "TUE", "WED", "THU", "FRI"],
      "imbalanceThresholdPct": 50,
      "imbalanceWindowWeeks": 2,
      "focusKeywords": ["Focus", "Deep Work", "Blocked", "No meetings", "Writing"],
      "_categorisationNote": "Events are recurring (recurrence set or title matches smart meeting), focus (no attendees or title matches focusKeywords; unbooked working time counts as focus), or ad-hoc (everything else with attendees). Balance is calculated from 4 weeks of calendarView history — no persistent state needed.",
      "_note": "Alert when any single category (focus/recurring/adhoc) exceeds imbalanceThresholdPct for imbalanceWindowWeeks consecutive weeks"
    }
  },
