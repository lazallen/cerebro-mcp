{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Email Triage Task Configuration",
  "description": "Configuration schema for email-triage task type",
  "type": "object",
  "properties": {
    "maxEmails": {
      "type": "integer",
      "description": "Maximum number of emails to process per execution",
      "minimum": 1,
      "maximum": 100,
      "default": 50,
      "examples": [50]
    },
    "markAsRead": {
      "type": "boolean",
      "description": "Whether to mark processed emails as read in inbox",
      "default": false,
      "examples": [false, true]
    },
    "eventType": {
      "type": "string",
      "description": "Event type identifier used in event file naming",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 1,
      "maxLength": 32,
      "default": "email",
      "examples": ["email", "email-triage"]
    },
    "filterFolder": {
      "type": "string",
      "description": "Optional: Filter emails from specific folder (e.g., 'inbox/priority')",
      "minLength": 1,
      "examples": ["inbox", "inbox/important"]
    },
    "llmTimeout": {
      "type": "integer",
      "description": "Timeout in milliseconds for LLM inference per email",
      "minimum": 1000,
      "maximum": 60000,
      "default": 10000,
      "examples": [10000]
    },
    "batchSize": {
      "type": "integer",
      "description": "Number of emails to process concurrently",
      "minimum": 1,
      "maximum": 20,
      "default": 10,
      "examples": [10]
    }
  },
  "examples": [
    {
      "maxEmails": 50,
      "markAsRead": false,
      "eventType": "email",
      "llmTimeout": 10000,
      "batchSize": 10
    },
    {
      "maxEmails": 25,
      "markAsRead": true,
      "eventType": "email-priority",
      "filterFolder": "inbox/priority",
      "llmTimeout": 15000,
      "batchSize": 5
    }
  ]
}
