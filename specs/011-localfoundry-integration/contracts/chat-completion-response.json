{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chat Completion Response",
  "description": "Response payload from LocalFoundry Chat Completions API (OpenAI-compatible format)",
  "type": "object",
  "required": ["id", "object", "created", "model", "choices"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for this completion",
      "examples": ["chatcmpl-abc123"]
    },
    "object": {
      "type": "string",
      "const": "chat.completion",
      "description": "Object type identifier"
    },
    "created": {
      "type": "integer",
      "description": "Unix timestamp (seconds since epoch) of response creation",
      "examples": [1706198400]
    },
    "model": {
      "type": "string",
      "description": "Model that generated the response",
      "examples": ["phi-4"]
    },
    "choices": {
      "type": "array",
      "description": "Array of completion choices",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "message", "finish_reason"],
        "properties": {
          "index": {
            "type": "integer",
            "description": "Choice index (0-based)",
            "minimum": 0
          },
          "message": {
            "type": "object",
            "required": ["role", "content"],
            "description": "Generated message from the model",
            "properties": {
              "role": {
                "type": "string",
                "const": "assistant",
                "description": "Message role (always 'assistant' in response)"
              },
              "content": {
                "type": "string",
                "description": "Generated text content",
                "minLength": 1
              }
            }
          },
          "finish_reason": {
            "type": "string",
            "enum": ["stop", "length", "content_filter"],
            "description": "Reason generation stopped: 'stop' (natural completion), 'length' (max tokens), 'content_filter' (filtered)"
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "description": "Token usage statistics (optional)",
      "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "description": "Tokens in input prompt",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "description": "Tokens in generated completion",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "description": "Total tokens (prompt + completion)",
          "minimum": 0
        }
      }
    }
  },
  "examples": [
    {
      "id": "chatcmpl-abc123",
      "object": "chat.completion",
      "created": 1706198400,
      "model": "phi-4",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": "This is the generated response text from the model."
          },
          "finish_reason": "stop"
        }
      ],
      "usage": {
        "prompt_tokens": 50,
        "completion_tokens": 100,
        "total_tokens": 150
      }
    }
  ]
}
