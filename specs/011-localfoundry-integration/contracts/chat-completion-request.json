{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chat Completion Request",
  "description": "Request payload for LocalFoundry Chat Completions API (OpenAI-compatible format)",
  "type": "object",
  "required": ["model", "messages"],
  "properties": {
    "model": {
      "type": "string",
      "description": "Model identifier to use for completion",
      "examples": ["phi-4", "llama-3", "mistral-7b"]
    },
    "messages": {
      "type": "array",
      "description": "Array of conversation messages",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["system", "user", "assistant"],
            "description": "Message role type"
          },
          "content": {
            "type": "string",
            "description": "Message text content",
            "minLength": 1
          }
        }
      }
    },
    "temperature": {
      "type": "number",
      "description": "Sampling temperature (0.0 to 2.0). Higher values make output more random.",
      "minimum": 0.0,
      "maximum": 2.0,
      "default": 0.7
    },
    "max_tokens": {
      "type": "integer",
      "description": "Maximum number of tokens to generate",
      "minimum": 1,
      "examples": [2000, 4000]
    },
    "top_p": {
      "type": "number",
      "description": "Nucleus sampling parameter",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 1.0
    },
    "frequency_penalty": {
      "type": "number",
      "description": "Penalty for token frequency (reduces repetition)",
      "minimum": -2.0,
      "maximum": 2.0,
      "default": 0.0
    },
    "presence_penalty": {
      "type": "number",
      "description": "Penalty for token presence (encourages new topics)",
      "minimum": -2.0,
      "maximum": 2.0,
      "default": 0.0
    },
    "stop": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 4
        }
      ],
      "description": "Stop sequences where generation should end"
    }
  },
  "examples": [
    {
      "model": "phi-4",
      "messages": [
        {
          "role": "system",
          "content": "You are a helpful assistant."
        },
        {
          "role": "user",
          "content": "Summarize this text: ..."
        }
      ],
      "temperature": 0.7,
      "max_tokens": 2000
    }
  ]
}
