{
  "mcpServers": {
    "cerebro": {
      "command": "node",
      "args": [
        "/path/to/cerebro-mcp/index.js"
      ],
      "env": {
        "OUTLOOK_CLIENT_ID": "your-microsoft-client-id-here",
        "OUTLOOK_CLIENT_SECRET": "your-microsoft-client-secret-here",
        "SLACK_CLIENT_ID": "your-slack-client-id-here",
        "SLACK_CLIENT_SECRET": "your-slack-client-secret-here",
        "USE_TEST_MODE": "false"
      }
    }
  }
}
