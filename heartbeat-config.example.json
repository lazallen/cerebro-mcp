{
  "rootDir": "./data",
  "tasks": [
    {
      "id": "email-triage-hourly",
      "name": "Hourly Email Triage",
      "type": "email-triage",
      "schedule": "0 * * * *",
      "enabled": true,
      "config": {
        "maxEmails": 50,
        "markAsRead": false,
        "eventType": "email",
        "llmTimeout": 30000,
        "batchSize": 10
      }
    },
    {
      "id": "email-priority-15min",
      "name": "Priority Email Triage (Every 15 Minutes)",
      "type": "email-triage",
      "schedule": "*/15 * * * *",
      "enabled": false,
      "config": {
        "maxEmails": 10,
        "markAsRead": true,
        "eventType": "email-priority",
        "filterFolder": "inbox/important",
        "llmTimeout": 5000,
        "batchSize": 5
      }
    },
    {
      "id": "journal-triage-hourly",
      "name": "Hourly Journal Triage",
      "type": "journal-triage",
      "schedule": "0 * * * *",
      "enabled": true,
      "config": {
        "lookaheadDays": 7,
        "journalDir": "areas/journal",
        "createOneNotePages": false,
        "workdaysOnly": true
      }
    },
    {
      "id": "journal-triage-15min",
      "name": "Journal Triage (Every 15 Minutes)",
      "type": "journal-triage",
      "schedule": "*/15 * * * *",
      "enabled": false,
      "config": {
        "lookaheadDays": 3,
        "journalDir": "areas/journal",
        "createOneNotePages": true,
        "workdaysOnly": true
      }
    },
    {
      "id": "journal-triage-daily",
      "name": "Daily Journal Triage (Morning at 8 AM)",
      "type": "journal-triage",
      "schedule": "0 8 * * *",
      "enabled": false,
      "config": {
        "lookaheadDays": 14,
        "journalDir": "areas/journal",
        "createOneNotePages": true,
        "workdaysOnly": true
      }
    },
    {
      "id": "email-ingestion-hourly",
      "name": "Hourly Email Ingestion (Feature 019)",
      "type": "email-ingestion",
      "schedule": "5 * * * *",
      "enabled": false,
      "config": {
        "maxEmails": 50,
        "folder": "inbox"
      }
    },
    {
      "id": "policy-pipeline-hourly",
      "name": "Hourly Policy Pipeline (Feature 019)",
      "type": "policy-pipeline",
      "schedule": "10 * * * *",
      "enabled": false,
      "config": {
        "batchSize": 50
      }
    },
    {
      "id": "pipeline-archive-nightly",
      "name": "Nightly Pipeline Archiving Sweep",
      "type": "pipeline-archive",
      "schedule": "0 3 * * *",
      "enabled": true,
      "config": {}
    },
    {
      "id": "slack-saved-items-ingestion-15min",
      "name": "Slack Saved Items Ingestion (Every 15 Minutes)",
      "type": "slack-saved-items-ingestion",
      "schedule": "*/15 * * * *",
      "enabled": false,
      "config": {
        "markAsComplete": true
      }
    },
    {
      "id": "smart-meeting-forward",
      "name": "Smart Meeting Scheduler — Forward Scheduling",
      "type": "smart-meeting-scheduler",
      "schedule": "0 7 * * 1-5",
      "enabled": false,
      "config": {
        "phase": "forward-scheduling",
        "configPath": "./smart-meetings-config.json"
      }
    },
    {
      "id": "smart-meeting-rebalance",
      "name": "Smart Meeting Scheduler — Weekly Rebalance",
      "type": "smart-meeting-scheduler",
      "schedule": "0 8 * * 1",
      "enabled": false,
      "config": {
        "phase": "rebalance",
        "configPath": "./smart-meetings-config.json"
      }
    }
  ]
}
