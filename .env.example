# ============================================================================
# Cerebro MCP TypeScript - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------

# Server name (default: cerebro-mcp-ts)
SERVER_NAME=cerebro-mcp-ts

# Server version (default: 0.3.0)
SERVER_VERSION=0.3.0

# OAuth authentication server port (default: 3333)
# IMPORTANT: OAuth apps are already registered with callback URLs on port 3333
# Changing this will break existing OAuth registrations
AUTH_SERVER_PORT=3333

# MCP server port for direct HTTP access (default: 3334)
# Separate port allows HTTP access for MCP clients that have SSL certificate issues
# while keeping OAuth secure on HTTPS (port 3333)
MCP_SERVER_PORT=3334

# Disable SSL and use HTTP instead of HTTPS (true/false, default: false)
# Set to true if having SSL certificate issues with MCP clients
# WARNING: Less secure - use only in development
# USE_HTTP=true

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Pretty print logs (true/false, default: true in development)
# Set to false for production JSON logging
LOG_PRETTY=true

# Node environment (development, production, test)
NODE_ENV=development

# ----------------------------------------------------------------------------
# Testing Configuration
# ----------------------------------------------------------------------------

# Use mock/test mode (true/false, default: false)
# When true, API calls return mock data instead of real requests
USE_TEST_MODE=false

# ----------------------------------------------------------------------------
# Microsoft 365 Configuration
# ----------------------------------------------------------------------------
# To use Microsoft 365 integration, you need to register an Azure AD app
# at https://portal.azure.com/

# Microsoft OAuth Client ID
MICROSOFT_CLIENT_ID=your-client-id-here

# Microsoft OAuth Client Secret
MICROSOFT_CLIENT_SECRET=your-client-secret-here

# Microsoft Tenant ID (use "common" for multi-tenant, or your tenant ID)
MICROSOFT_TENANT_ID=common

# Note: OAuth redirect URI, scopes, and token storage path are configured in code
# Redirect URI: https://localhost:3333/auth/microsoft/callback
# Scopes: offline_access, Mail.Read, Mail.Send, User.Read, Calendars.Read, Calendars.ReadWrite, Place.Read.All, Notes.ReadWrite
# - Place.Read.All: Required for meeting room discovery and booking features
# Token storage: ./.tokens/microsoft-tokens.json

# ----------------------------------------------------------------------------
# Heartbeat System Configuration
# ----------------------------------------------------------------------------
# Scheduled task automation system for email triage, calendar review, and journal triage

# Heartbeat Root Directory: Base directory for event storage, logs, and journal files
# Journal files are stored in: {HEARTBEAT_ROOT_DIR}/areas/journal/YYYY-MM/YYYY-MM-DD.md
# Example: ./data/areas/journal/2026-02/2026-02-18.md
HEARTBEAT_ROOT_DIR=./data

# Heartbeat Config File: Path to JSON configuration file for scheduled tasks
# See heartbeat-config.example.json for configuration options
HEARTBEAT_CONFIG_FILE=./heartbeat-config.json

# ----------------------------------------------------------------------------
# Slack Configuration
# ----------------------------------------------------------------------------
# To use Slack integration, you need to create a Slack app
# at https://api.slack.com/apps

# Slack OAuth Client ID
SLACK_CLIENT_ID=your-client-id-here

# Slack OAuth Client Secret
SLACK_CLIENT_SECRET=your-client-secret-here

# Note: OAuth redirect URI, scopes, and token storage path are configured in code
# Redirect URI: https://localhost:3333/auth/slack/callback
# User scopes: channels:read, channels:history, groups:read, groups:history, canvases:read, canvases:write, identify, reminders:read, reminders:write
# Token storage: ./.tokens/slack-tokens.json

# ----------------------------------------------------------------------------
# API Configuration
# ----------------------------------------------------------------------------

# Default API request timeout in milliseconds (default: 30000 = 30 seconds)
API_TIMEOUT=30000

# MCP server request timeout in milliseconds (default: 30000 = 30 seconds)
MCP_TIMEOUT=30000

# Log tool input parameters in MCP requests (true/false, default: false)
# WARNING: This may log sensitive data in production
MCP_LOG_TOOL_INPUT=false

# ----------------------------------------------------------------------------
# Security Configuration
# ----------------------------------------------------------------------------

# Token refresh buffer time in milliseconds (default: 300000 = 5 minutes)
# Tokens will be refreshed this many milliseconds before expiry
TOKEN_REFRESH_BUFFER=300000

# ----------------------------------------------------------------------------
# Slack Message Actions Configuration (Socket Mode)
# ----------------------------------------------------------------------------
# Required for receiving Slack message shortcuts via Socket Mode
# Get this from your Slack app's Basic Information page under "App-Level Tokens"

# Slack App Level Token (for Socket Mode - must start with xapp-)
# Generate this with the connections:write scope
SLACK_APP_TOKEN=xapp-your-app-level-token-here

# ----------------------------------------------------------------------------
# LocalFoundry Configuration
# ----------------------------------------------------------------------------
# Local LLM endpoint URL for text processing (summarize, clarify, extract)
# Example: http://localhost:8080/v1/chat/completions
LOCALFOUNDRY_ENDPOINT=http://localhost:8080/v1/chat/completions

# Optional: Default model name (if LocalFoundry requires model parameter)
LOCALFOUNDRY_MODEL=phi-4

# Optional: Request timeout in milliseconds (default: 60000 = 1 minute)
LOCALFOUNDRY_TIMEOUT=60000

# ----------------------------------------------------------------------------
# OneNote OCR Configuration
# ----------------------------------------------------------------------------
# Tesseract.js language for handwriting recognition (default: eng)
# Supported: eng, fra, deu, spa, ita, por, rus, chi_sim, jpn, kor, ara, etc.
TESSERACT_LANG=eng

# Optional: Save rendered PNG images for debugging (true/false, default: false)
# Images saved to ./debug/ink-{pageId}.png
ONENOTE_DEBUG_IMAGES=false
