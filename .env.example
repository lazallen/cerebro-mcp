# Cerebro MCP Server Configuration
# Multi-service MCP server for productivity tools

# =============================================================================
# Microsoft 365 / Outlook Configuration
# =============================================================================
# Get these credentials from Azure Portal > App Registrations > Your App

# Application (client) ID from Azure Portal
MS_CLIENT_ID=your-client-id-here

# Client secret VALUE (not the secret ID) from Azure Portal > Certificates & secrets
MS_CLIENT_SECRET=your-client-secret-here

# Directory (tenant) ID from Azure Portal > Overview
# Use 'common' for multi-tenant, 'organizations' for any org account, or your specific tenant ID
MS_TENANT_ID=common

# =============================================================================
# Slack Configuration
# =============================================================================
# Get these from https://api.slack.com/apps
# Setup guide: See SLACK_SETUP.md

# SLACK_CLIENT_ID=your-slack-client-id-here
# SLACK_CLIENT_SECRET=your-slack-client-secret-here
# SLACK_REDIRECT_URI=https://localhost:3333/auth/slack/callback

# =============================================================================
# Global Settings
# =============================================================================

# Enable test mode with mock data (true/false)
USE_TEST_MODE=false
