{
  "name": "cerebro-mcp-ts",
  "version": "0.3.0",
  "description": "TypeScript implementation of Cerebro MCP - Model Context Protocol server for Microsoft 365, Slack, and extensible service integrations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:pretty": "node dist/index.js | pino-pretty",
    "dev": "ts-node src/index.ts",
    "dev:pretty": "ts-node src/index.ts | pino-pretty",
    "prepare": "husky install",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "microsoft365",
    "slack",
    "oauth",
    "anthropic",
    "claude"
  ],
  "author": "Stuart Davidson",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "canvas": "^3.2.1",
    "dotenv": "^16.4.1",
    "fast-xml-parser": "^5.3.3",
    "marked": "^17.0.1",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.8.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.17",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.10",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
